rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Definition
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'kanata840@gmail.com' && request.auth.token.email_verified == true;
    }

    function existing() {
      return resource.data;
    }

    // match /approved_users
    match /approved_users/{docId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.token.email == existing().email);
      allow write: if isAdmin();
    }

    // match /analyses
    match /analyses/{analysisId} {
      // Admin has full read and write
      allow read: if isAdmin();
      allow write: if isAdmin();
      
      // Normal users can only read their own data
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
